# ---------------------------------------------------------------------------
# kprsnt.in environment variables
# Copy to .env for local development. Never commit real secrets.
# On Cloud Run, set these in the service (Console → Edit & deploy → Variables)
# or as Secret Manager secrets mounted with --set-secrets (see README). None of
# them are baked into the image.
# ---------------------------------------------------------------------------

# --- LLM providers (tried in order OpenAI -> Gemini -> NVIDIA -> Groq; any one works) ---
# Cloud Run deploys pass only GEMINI_API_KEY today.
GEMINI_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# --- Used by local pipeline scripts / GitHub Actions ---
TAVILY_API_KEY=
GITHUB_TOKEN=

# --- Email ---
# The app sends no email. Mail to interview@ / chat@ / security@kprsnt.in is
# forwarded to a personal inbox by Cloudflare Email Routing (see README).

# --- Private data ---
# Required as the X-Private-Token header to read /api/jobs/data. Unset = 404.
PRIVATE_API_TOKEN=
# Phone number printed on the resume PDF. Local use only, when building a PDF
# to send to someone: it is deliberately not stored in the repository.
RESUME_PHONE=

# --- Hosting ---
# Requests for www.<host> or straight to *.run.app (not via Cloudflare) are
# redirected here. Defaults to kprsnt.in; set it empty to disable (e.g. a fork).
CANONICAL_HOST=kprsnt.in

# --- Local Flask server ---
FLASK_DEBUG=false
