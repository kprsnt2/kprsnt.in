# ---------------------------------------------------------------------------
# kprsnt.in environment variables
# Copy to .env for local development. Never commit real secrets.
# On Cloud Run, set these in the service (Console → Edit & deploy → Variables)
# or as Secret Manager secrets mounted with --set-secrets (see README). None of
# them are baked into the image.
# ---------------------------------------------------------------------------

# --- LLM providers (the app falls back OpenAI -> NVIDIA -> Groq) ---
OPENAI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# --- Used by local pipeline scripts / GitHub Actions ---
GEMINI_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

# --- Email (Resend) for the interview/chat bot ---
RESEND_API_KEY=
# Sender address for bot replies (must be verified in Resend)
INTERVIEW_FROM_EMAIL=chat@kprsnt.in
# Where "someone used the bot" notifications are sent
OWNER_NOTIFY_EMAIL=
# Shared secret the inbound-email worker sends as X-Email-Webhook-Secret.
# Without it (or with it unset) the bot never sends email to a caller-supplied
# address; it only answers in the HTTP response.
EMAIL_WEBHOOK_SECRET=

# --- Private data ---
# Required as the X-Private-Token header to read /api/jobs/data. Unset = 404.
PRIVATE_API_TOKEN=
# Phone number printed on the resume PDF. Local use only, when building a PDF
# to send to someone: it is deliberately not stored in the repository.
RESUME_PHONE=

# --- Local Flask server ---
FLASK_DEBUG=false
