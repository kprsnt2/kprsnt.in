{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "blog_data/**,blog_inputs/**,templates/**"
      }
    },
    {
      "src": "api/interview.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/chat_agent.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/api/interview",
      "dest": "/api/interview.py"
    },
    {
      "src": "/api/chat_agent",
      "dest": "/api/chat_agent.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}