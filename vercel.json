{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/interview.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/chat_agent.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/interview",
      "dest": "/api/interview.py"
    },
    {
      "src": "/api/chat_agent",
      "dest": "/api/chat_agent.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}